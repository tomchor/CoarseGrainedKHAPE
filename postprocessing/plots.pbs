#!/bin/bash -l
#PBS -N plots_Nz2048_Ri0.10
#PBS -o logs/plots_Nz2048_Ri0.10.log
#PBS -e logs/plots_Nz2048_Ri0.10.log
# Note: job name above is a default; qalter below updates it at runtime based on NZ
# Log file paths (-o/-e) cannot be changed at runtime; use the .out file for per-run logs
#PBS -l walltime=02:00:00
#PBS -q casper
#PBS -m ae
#PBS -r n
#PBS -l select=1:ncpus=8:mem=128GB:ngpus=0
#PBS -l job_priority=regular

# Final figures: every postprocessing/plot*.py (the simulation, budgeting and sweep pipelines must have run).
set -eo pipefail

NZ=${NZ:-2048}
SIM=khi_Nz${NZ}_Ri0.10
OUT_DIR=${KHAPE_OUTPUT_DIR:-output}   # where simulation.pbs wrote the run; kelvin_helmholtz_instability.jl reads the same variable
PYTHON=${KHAPE_PYTHON:?submit through the submit_*.sh wrappers, which pass KHAPE_PYTHON}
JOB_NAME="plots_Nz${NZ}_Ri0.10"
qalter -N "$JOB_NAME" "$PBS_JOBID"

module li
module --force purge
module load ncarenv/25.10
module li

echo $CUDA_VISIBLE_DEVICES

LOG=logs/${JOB_NAME}.out
: > $LOG
# Every plot*.py here is a figure script taking --filename; run them all, in name order, so a renamed or added
# figure needs no change to this job. plot2 needs the sweep output, plot3 the simulation's _2d.nc file, plot5 the
# integrated budgets and plot6 the budget fields.
for script in plot*.py; do
    time $PYTHON -u $script --filename $OUT_DIR/${SIM}.nc 2>&1 | tee -a $LOG
done

qstat -f $PBS_JOBID >> $LOG
