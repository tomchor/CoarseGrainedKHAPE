#!/bin/bash -l
#PBS -A UMCP0023
#PBS -N sweep_filter_Nz4096_Ri0.10
#PBS -o logs/sweep_filter_Nz4096_Ri0.10.log
#PBS -e logs/sweep_filter_Nz4096_Ri0.10.log
# Note: job name above is a default; qalter below updates it at runtime based on NZ
# Log file paths (-o/-e) cannot be changed at runtime; use the .out file for per-run logs
#PBS -l walltime=23:59:00
#PBS -q casper
#PBS -M wenegrat@umd.edu
#PBS -m ae
#PBS -r n
#PBS -l select=1:ncpus=18:mem=730GB:ngpus=0
#PBS -l job_priority=premium

set -eo pipefail

NZ=${NZ:-4096}
N_TIME_SKIP=${N_TIME_SKIP:-2}
# How b and b_* are extended past the walls: 'edge' repeats the wall value (the manuscript's §4 choice),
# 'odd' reflects oddly about it. Both are admissible under §2, so running both measures how much of the
# spectrum at large ℓ is set by the choice rather than the flow. 'odd' writes to _sweep_odd files.
EXTENSION=${EXTENSION:-edge}
SIM=khi_Nz${NZ}_Ri0.10
OUT_DIR=${KHAPE_OUTPUT_DIR:-output}   # where simulation.pbs wrote the run; kelvin_helmholtz_instability.jl reads the same variable
PYTHON=/glade/work/wenegrat/conda-envs/py313/bin/python
[ "$EXTENSION" = "edge" ] && EXT_TAG="" || EXT_TAG="_${EXTENSION}"
JOB_NAME="sweep_filter_Nz${NZ}_Ri0.10${EXT_TAG}"
qalter -N "$JOB_NAME" "$PBS_JOBID"

# Clear the environment from any previously loaded modules
module li
module --force purge
module load ncarenv/25.10
module li

#/glade/u/apps/ch/opt/usr/bin/dumpenv # Dumps environment (for debugging with CISL support)

echo $CUDA_VISIBLE_DEVICES

time $PYTHON -u sweep1_filter_fields.py --filename $OUT_DIR/${SIM}.nc --n-time-skip $N_TIME_SKIP --extension $EXTENSION 2>&1 | tee logs/${JOB_NAME}.out

qstat -f $PBS_JOBID >> logs/${JOB_NAME}.out
