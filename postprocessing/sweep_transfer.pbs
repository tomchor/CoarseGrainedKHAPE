#!/bin/bash -l
#PBS -N sweep_transfer_Nz4096_Ri0.10
#PBS -o logs/sweep_transfer_Nz4096_Ri0.10.log
#PBS -e logs/sweep_transfer_Nz4096_Ri0.10.log
# Note: job name above is a default; qalter below updates it at runtime based on NZ/FIXED_REF
# Log file paths (-o/-e) cannot be changed at runtime; use the .out file for per-run logs
#PBS -l walltime=23:59:00
#PBS -q casper
#PBS -m ae
#PBS -r n
#PBS -l select=1:ncpus=18:mem=730GB:ngpus=0
#PBS -l job_priority=premium

set -eo pipefail

NZ=${NZ:-4096}
SIM=khi_Nz${NZ}_Ri0.10
OUT_DIR=${KHAPE_OUTPUT_DIR:-output}   # where simulation.pbs wrote the run; kelvin_helmholtz_instability.jl reads the same variable
PYTHON=${KHAPE_PYTHON:?submit through the submit_*.sh wrappers, which pass KHAPE_PYTHON}
FIXED_REF=${FIXED_REF:-0}
EXTENSION=${EXTENSION:-edge}   # must match the sweep_filter run this reads; see sweep_filter.pbs
[ "$EXTENSION" = "edge" ] && EXT_TAG="" || EXT_TAG="_${EXTENSION}"
[ "$FIXED_REF" = "1" ] && FIXED_REF_FLAG="--fixed-reference" && REF_SUFFIX="_fixed_ref" || { FIXED_REF_FLAG=""; REF_SUFFIX=""; }
JOB_NAME="sweep_transfer_Nz${NZ}_Ri0.10${REF_SUFFIX}${EXT_TAG}"
qalter -N "$JOB_NAME" "$PBS_JOBID"

# Clear the environment from any previously loaded modules
module li
module --force purge
module load ncarenv/25.10
module li

#/glade/u/apps/ch/opt/usr/bin/dumpenv # Dumps environment (for debugging with CISL support)

echo $CUDA_VISIBLE_DEVICES

time $PYTHON -u sweep2_energy_transfer.py --filename $OUT_DIR/${SIM}.nc --n-workers 18 --extension $EXTENSION $FIXED_REF_FLAG 2>&1 | tee logs/${JOB_NAME}.out
# sweep3 reads the default (edge) transfer file, so it is only meaningful for the edge run. An `if`
# rather than `cond && cmd`: under `set -e` a false test as the last command would fail the job.
if [ "$EXTENSION" = "edge" ]; then
    time $PYTHON -u sweep3_plot_transfer_spectrum.py --filename $OUT_DIR/${SIM}.nc $FIXED_REF_FLAG 2>&1 | tee -a logs/${JOB_NAME}.out
fi

qstat -f $PBS_JOBID >> logs/${JOB_NAME}.out
