#!/bin/bash -l
#PBS -N budgeting_Nz2048_Ri0.10
#PBS -o logs/budgeting_Nz2048_Ri0.10.log
#PBS -e logs/budgeting_Nz2048_Ri0.10.log
# Note: job name above is a default; qalter below updates it at runtime based on NZ
# Log file paths (-o/-e) cannot be changed at runtime; use the .out file for per-run logs
#PBS -l walltime=04:00:00
#PBS -q casper
#PBS -m ae
#PBS -r n
#PBS -l select=1:ncpus=4:mem=120GB:ngpus=0
#PBS -l job_priority=premium

# The budgets are assembled from the terms the simulation computed online (01_online_budgets.py), then
# plotted: a read-and-write job, not the 18-worker sort-and-filter one the offline pipeline needed. That
# pipeline lives in offline/ and runs only as the CI cross-check.
set -eo pipefail

NZ=${NZ:-512}
SIM=Nz${NZ}_Ri0.10
OUT_DIR=${KHAPE_OUTPUT_DIR:-output}   # where simulation.pbs wrote the run; kelvin_helmholtz_instability.jl reads the same variable
PYTHON=${KHAPE_PYTHON:?submit through the submit_*.sh wrappers, which pass KHAPE_PYTHON}
JOB_NAME="budgeting_Nz${NZ}_Ri0.10"
qalter -N "$JOB_NAME" "$PBS_JOBID"

# Clear the environment from any previously loaded modules
module li
module --force purge
module load ncarenv/25.10
module li

#/glade/u/apps/ch/opt/usr/bin/dumpenv # Dumps environment (for debugging with CISL support)

time $PYTHON -u 01_online_budgets.py --filename $OUT_DIR/khi_${SIM}.nc 2>&1 | tee    logs/${JOB_NAME}.out
time $PYTHON -u 02_plot_budgets.py   --filename $OUT_DIR/khi_${SIM}.nc 2>&1 | tee -a logs/${JOB_NAME}.out

qstat -f $PBS_JOBID >> logs/${JOB_NAME}.out
