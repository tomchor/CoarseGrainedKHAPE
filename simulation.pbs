#!/bin/bash -l
#PBS -A UMCP0061
#PBS -N kelvin_helmholtz_1024
#PBS -o logs/kelvin_helmholtz_1024.log
#PBS -e logs/kelvin_helmholtz_1024.log
#PBS -l walltime=23:59:00
#PBS -q casper
#PBS -M tchor@umd.edu
#PBS -m ae
#PBS -r n
#PBS -l select=1:ncpus=8:ngpus=1:gpu_type=a100:mem=64GB
#PBS -l job_priority=regular

set -eo pipefail

# Clear the environment from any previously loaded modules
module li
module --force purge
module load ncarenv/25.10
module li

#/glade/u/apps/ch/opt/usr/bin/dumpenv # Dumps environment (for debugging with CISL support)

echo $CUDA_VISIBLE_DEVICES

NZ=${NZ:-1024}
SAVE_TENSORS=${SAVE_TENSORS:-0}
[ "$SAVE_TENSORS" = "1" ] && TENSOR_FLAG="--save_tensors" || TENSOR_FLAG=""
SAVE_SORTED=${SAVE_SORTED:-1}   # on by default: 03/05 read the online Pi_A and eps_As from it
[ "$SAVE_SORTED" = "1" ] && SORTED_FLAG="--save_sorted" || SORTED_FLAG=""

export JULIA_DEPOT_PATH="$WORK/.julia"
export JULIA_CPU_TARGET="generic"

# Julia 1.12.6 has a GPU-codegen regression (InvalidIRError in gpu_fill_kernel!); 1.12.4 works. How you get
# 1.12.4 is per-user, so find it rather than assume: $JULIA if the caller set one, else juliaup, else a
# standalone tarball under $WORK. Hard-coding either route means whoever uses the other carries a local
# edit to this file, and loses it at the next pull -- which has happened.
if [ -n "${JULIA:-}" ]; then
    echo "Using \$JULIA = $JULIA"
elif command -v juliaup >/dev/null 2>&1; then
    juliaup add 1.12.4
    JULIA="julia +1.12.4"
elif [ -x "$WORK/julia-1.12.4/bin/julia" ]; then
    JULIA="$WORK/julia-1.12.4/bin/julia"
else
    echo "error: no Julia 1.12.4 found. Set \$JULIA, install juliaup, or unpack the 1.12.4 tarball to" >&2
    echo "       \$WORK/julia-1.12.4 (https://julialang-s3.julialang.org/bin/linux/x64/1.12/julia-1.12.4-linux-x86_64.tar.gz)" >&2
    exit 1
fi
$JULIA --version

time $JULIA --project -t 8 kelvin_helmholtz_instability.jl --Nz $NZ $TENSOR_FLAG $SORTED_FLAG 2>&1 | tee logs/kelvin_helmholtz_${NZ}.out

qstat -f $PBS_JOBID >> logs/kelvin_helmholtz_${NZ}.log
qstat -f $PBS_JOBID >> logs/kelvin_helmholtz_${NZ}.out
